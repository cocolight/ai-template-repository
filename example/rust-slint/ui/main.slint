import { Button } from "std-widgets.slint";

export component MainWindow inherits Window {
    title: "计数器";
    in-out property <int> counter: 0;
    // UI 只负责「请求增减」，真正的计数逻辑在 Rust 侧（见 src/main.rs）。
    callback increment(int);

    VerticalLayout {
        spacing: 8px;
        Text {
            text: "计数: {counter}";
            font-size: 24px;
        }
        HorizontalLayout {
            Button {
                text: "-1";
                clicked => { root.increment(-1); }
            }
            Button {
                text: "+1";
                clicked => { root.increment(1); }
            }
        }
    }
}
